# Port the Node API/socket server listens on (Vite proxies to it in dev)
API_PORT=8787
# Path to the SQLite database file (created automatically)
DB_PATH=./data/deep.db
# Secret used to sign anonymous player tokens. Use a long random string in production.
PLAYER_SECRET=change-me-to-a-long-random-string
# Dive #1 date (YYYY-MM-DD). Each later day is the next dive.
LAUNCH_DATE=2026-11-23
# Optional: Turso database (libsql://...) + token. When set, the server keeps a local replica
# and writes to Turso, so data survives hosts with throwaway disks. Leave unset for a local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
